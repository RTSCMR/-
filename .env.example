# قاعدة البيانات (SQLite). للتحويل إلى Postgres غيّر provider في prisma/schema.prisma وهذا الرابط.
DATABASE_URL="file:./dev.db"

# حساب المشرف الذي ينشئه أمر db:seed (غيّر كلمة المرور قبل أي نشر)
ADMIN_EMAIL="admin@alf.sa"
ADMIN_PASSWORD="change-me-please"

# مجلد لقطات الشاشة المرفوعة (اختياري، الافتراضي ./uploads)
# UPLOAD_DIR="./uploads"

# إشعارات الإيميل عبر Resend (اختياري). بدونها المنصة تشتغل بالتنبيهات الداخلية فقط.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="ألف <no-reply@your-domain.com>"   # لازم يكون على دومين موثّق في Resend
# APP_URL="https://your-domain.com"             # يُستخدم في روابط الإيميل
